# SMTP credentials for sdlctechacademy@gmail.com, used to send contact-form
# notifications (still delivered to info@sdlctechacademy.com — see
# NOTIFY_EMAIL in app/api/contact/route.ts). Gmail requires 2-Step
# Verification to be enabled on the account, then an App Password generated
# at https://myaccount.google.com/apppasswords — use that 16-character
# password below, not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sdlctechacademy@gmail.com
SMTP_PASSWORD=your-16-character-app-password
