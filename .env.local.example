# SMTP credentials for info@sdlctechacademy.com hosted on Microsoft
# (Microsoft 365 / Outlook). Get SMTP AUTH enabled for this mailbox in the
# Microsoft 365 admin center if sending fails with an auth error, and use an
# App Password instead of the normal login password if MFA is turned on
# (generate one at https://mysignins.microsoft.com/security-info).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@sdlctechacademy.com
SMTP_PASSWORD=your-account-or-app-password
